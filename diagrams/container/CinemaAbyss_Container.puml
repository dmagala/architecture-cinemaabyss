@startuml CinemaAbyss_ToBe_Architecture
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml


Person(user, "Пользователь", "Смотрит фильмы, управляет подпиской")

System_Boundary(cinema_system, "Кинобездна (To-Be)") {
    Container(api_gateway, "API Gateway", "Kong/Nginx", "Единая точка входа, маршрутизация, аутентификация")
    
    Container(auth_service, "Auth Service", "Go", "Аутентификация и авторизация")
    Container(users_service, "Users Service", "Go", "Управление пользователями")
    Container(movies_service, "Movies Service", "Go", "Метаданные о фильмах")
    Container(content_service, "Content Service", "Go", "Управление видео-контентом")
    Container(payments_service, "Payments Service", "Go", "Обработка платежей")
    Container(subscriptions_service, "Subscriptions Service", "Go", "Управление подписками")
    Container(recommendations_service, "Recommendations Service", "Python", "Генерация рекомендаций")
    Container(events_service, "Events Service", "Go", "Обработка событий")
    
    ContainerDb(postgresql, "PostgreSQL", "Основное хранилище данных")
    ContainerDb(redis, "Redis", "Кеш, сессии")
    ContainerDb(s3_storage, "S3 Storage", "Хранение видео-контента")
    
    ContainerQueue(kafka, "Kafka", "Асинхронная коммуникация") {
        Container(topic_user, "user-events", "Топик")
        Container(topic_payment, "payment-events", "Топик")
        Container(topic_movie, "movie-events", "Топик")
    }
}

System_Ext(payment_gateway, "Платежный шлюз", "Внешняя платежная система")
System_Ext(content_providers, "Провайдеры контента", "Сторонние кинотеатры")

Rel(user, api_gateway, "HTTPS", "API calls")
Rel(api_gateway, auth_service, "HTTP", "Аутентификация")
Rel(api_gateway, users_service, "HTTP", "Данные пользователя")
Rel(api_gateway, movies_service, "HTTP", "Метаданные")
Rel(api_gateway, content_service, "HTTP", "Контент")
Rel(api_gateway, payments_service, "HTTP", "Платежи")
Rel(api_gateway, subscriptions_service, "HTTP", "Подписки")
Rel(api_gateway, recommendations_service, "HTTP", "Рекомендации")

Rel(auth_service, redis, "TCP", "Сессии")
Rel(users_service, postgresql, "SQL", "Users DB")
Rel(movies_service, postgresql, "SQL", "Movies DB")
Rel(content_service, s3_storage, "API", "Видео-контент")
Rel(payments_service, postgresql, "SQL", "Payments DB")
Rel(subscriptions_service, postgresql, "SQL", "Subscriptions DB")

Rel(payments_service, payment_gateway, "HTTPS", "Обработка платежей")
Rel(content_service, content_providers, "API", "Получение контента")

Rel(users_service, kafka, "Pub/Sub", "События пользователей")
Rel(payments_service, kafka, "Pub/Sub", "События платежей")
Rel(movies_service, kafka, "Pub/Sub", "События фильмов")
Rel(events_service, kafka, "Pub/Sub", "Обработка событий")

Rel(recommendations_service, kafka, "Sub", "Чтение событий")
Rel(recommendations_service, postgresql, "SQL", "Данные для рекомендаций")

@enduml